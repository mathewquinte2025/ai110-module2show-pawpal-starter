
classDiagram
    class Owner {
        +String name
        +List~Pet~ pets
        +int available_time
        +dict preferences
        +add_pet(pet)
        +get_all_tasks()
    }

    class Pet {
        +String name
        +String species
        +int age
        +List~Task~ tasks
        +add_task(task)
        +remove_task(task)
        +get_tasks()
    }

    class Task {
        +String description
        +String time
        +int duration
        +String priority
        +String frequency
        +bool completed
        +mark_complete()
        +reschedule(new_time)
    }

    class Scheduler {
        +Owner owner
        +get_all_tasks()
        +sort_by_time()
    }

    Owner "1" --> "0..*" Pet : owns
    Pet "1" --> "0..*" Task : has
    Scheduler --> Owner : retrieves tasks from
